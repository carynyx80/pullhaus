# Local defaults. Do not set DEV_WALLET or the Anvil keys on Vercel.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4181
NEXT_PUBLIC_DEV_WALLET=true
NEXT_PUBLIC_ANVIL_RPC=http://127.0.0.1:8545

# LOCAL ANVIL DEV CONFIG ONLY.
# Foundry's published default private keys (accounts 0 and 2). Not secrets.
# scripts/dev.sh writes these into the gitignored web/.env.local file.
NEXT_PUBLIC_ANVIL_PATRON_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
NEXT_PUBLIC_ANVIL_GUEST_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Server-only. Used by Next middleware. Not exposed to the browser.
COUNTRY_BLOCK_ENABLED=false
BLOCKED_COUNTRIES=
# Chain the site points wallets at. Unset: Anvil in dev, BSC testnet (97) in production.
NEXT_PUBLIC_CHAIN_ID=

# Mainnet $PULL on BNB Smart Chain (chain 56), the token the swap desk buys.
# Leave this empty until the token launches. Do not put a placeholder address here.
# When it is empty, the desk shows "Launching soon" unless GET /config supplies pullTrade
# or the game itself is deployed on chain 56 with a real (non-mock) PULL token.
# NEXT_PUBLIC_PULL_TOKEN_ADDRESS=
# Page for the four.meme launch. Defaults to https://four.meme. Must be https.
# NEXT_PUBLIC_FOUR_MEME_URL=https://four.meme
