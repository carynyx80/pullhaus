# LOCAL DEV CONFIG. Copy to backend/.env (gitignored). Do not put real keys in this file.
DATABASE_URL=postgresql://pullhaus:pullhaus@127.0.0.1:5432/pullhaus
REDIS_URL=redis://127.0.0.1:6379
RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_PATH=../contracts/deployments/local.json
# Anvil account #1. Public test key. Refused automatically off local/opBNB-testnet chain ids.
KEEPER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
PORT=4181
WEB_ORIGIN=http://127.0.0.1:4180
PUBLIC_URL=http://127.0.0.1:4181
JWT_SECRET=replace-me
MEDIA_DRIVER=local
# s3 | greenfield
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
GREENFIELD_RPC_URL=
GREENFIELD_CHAIN_ID=5600
GREENFIELD_BUCKET=
GREENFIELD_PRIVATE_KEY=
GREENFIELD_PUBLIC_URL=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
COUNTRY_BLOCK_ENABLED=false
BLOCKED_COUNTRIES=
# Mainnet $PULL traded on PancakeSwap. Returned as pullTrade on GET /config.
# Leave empty until the token launches. Never put a placeholder address here.
# The web app also accepts NEXT_PUBLIC_PULL_TOKEN_ADDRESS, which wins when set.
# PULL_TRADE_ADDRESS=
# https URL for the Flap.sh launch page. Defaults to https://flap.sh.
# Returned as launchpadUrl on GET /config. The site root links a token to https://flap.sh/bnb/<address>.
# LAUNCHPAD_URL=https://flap.sh
